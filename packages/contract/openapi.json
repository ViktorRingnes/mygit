{
  "openapi": "3.1.0",
  "info": {
    "title": "mygit",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/branches": {
      "get": {
        "tags": [
          "branches"
        ],
        "operationId": "list_branches",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Branches"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/commits": {
      "get": {
        "tags": [
          "commits"
        ],
        "operationId": "list_commits",
        "parameters": [
          {
            "name": "rev",
            "in": "query",
            "description": "Branch, tag or commit to walk back from; defaults to the repository head",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "description": "Only commits that changed this file or directory",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Commits to skip",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Commits to return, 50 by default and 1000 at most",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commits"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/file": {
      "get": {
        "tags": [
          "files"
        ],
        "operationId": "get_file",
        "parameters": [
          {
            "name": "rev",
            "in": "query",
            "description": "Branch, tag or commit; defaults to the repository head",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "description": "File to read",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tree": {
      "get": {
        "tags": [
          "files"
        ],
        "operationId": "get_tree",
        "parameters": [
          {
            "name": "rev",
            "in": "query",
            "description": "Branch, tag or commit; defaults to the repository head",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "description": "Directory to list; defaults to the repository root",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Levels to descend, 1 by default; 0 lists every level",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Entries to skip",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Entries to return, 1000 by default and 10000 at most",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tree"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Branches": {
        "type": "object",
        "required": [
          "names",
          "default_branch",
          "head"
        ],
        "properties": {
          "default_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "head": {
            "type": [
              "string",
              "null"
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Commit": {
        "type": "object",
        "required": [
          "oid",
          "summary",
          "body",
          "author",
          "committer",
          "parents"
        ],
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Signature"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "committer": {
            "$ref": "#/components/schemas/Signature"
          },
          "oid": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "Commits": {
        "type": "object",
        "required": [
          "rev",
          "commit",
          "path",
          "entries",
          "offset",
          "has_more"
        ],
        "properties": {
          "commit": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Commit"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "type": "string"
          }
        }
      },
      "Entry": {
        "type": "object",
        "required": [
          "name",
          "path",
          "kind",
          "oid",
          "size"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/EntryKind"
          },
          "name": {
            "type": "string"
          },
          "oid": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "EntryKind": {
        "type": "string",
        "enum": [
          "directory",
          "file",
          "symlink",
          "submodule"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "rev",
          "commit",
          "path",
          "oid",
          "size",
          "binary",
          "oversized",
          "text"
        ],
        "properties": {
          "binary": {
            "type": "boolean"
          },
          "commit": {
            "type": "string"
          },
          "oid": {
            "type": "string"
          },
          "oversized": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "rev": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Signature": {
        "type": "object",
        "required": [
          "name",
          "email",
          "timestamp",
          "offset_minutes"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "offset_minutes": {
            "type": "integer",
            "format": "int32"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Tree": {
        "type": "object",
        "required": [
          "rev",
          "commit",
          "path",
          "entries",
          "offset",
          "total",
          "has_more"
        ],
        "properties": {
          "commit": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "path": {
            "type": "string"
          },
          "rev": {
            "type": "string"
          },
          "total": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      }
    }
  }
}
